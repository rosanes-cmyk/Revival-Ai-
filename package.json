{
  "name": "twin-text-platform",
  "version": "1.0.0",
  "description": "Twin Text Platform — live dashboard automation for the lead text-revival campaign. Uploads old high-equity leads (or pulls from REI), searches each in REI BlackBook via browser automation, enforces the SOP compliance/suppression rules, sends the approved revival text only when eligible, and tracks disposition/notes with resume + export.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "app": "electron electron/main.cjs",
    "predist": "node scripts/write-build-info.js",
    "dist": "electron-builder --win --publish never",
    "postinstall": "node -e \"console.log('Reminder: run npx playwright install chromium if browser automation is not already available.')\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^2.0.0",
    "playwright": "^1.44.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.twinhomebuyer.twintextplatform",
    "productName": "Twin Text Platform",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "config/**/*",
      "data/**/*",
      "build/icon.png",
      "package.json",
      "build-info.json",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Revival AI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
