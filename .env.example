# ---------------------------------------------------------------------------
# High Equity Lead Revival Dashboard - environment configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# Web server port
PORT=3000

# --- REI BlackBook login ---------------------------------------------------
# EMAIL/PASSWORD are OPTIONAL. Easiest & most reliable: leave them blank and,
# on the first run (with HEADLESS=false), just log into REI in the window that
# opens — even 2FA works — and it's remembered for every run after. If you do
# fill them in, it will try to auto-fill the login for you.
REIBB_LOGIN_URL=https://my.reiblackbook.com/services/account/login?block=
REIBB_EMAIL=
REIBB_PASSWORD=

# Direct page addresses. These defaults are the standard REI paths and usually
# work as-is; only change them if your account uses different URLs.
REIBB_PIPELINE_URL=https://my.reiblackbook.com/properties/inbox
REIBB_CONTACTS_URL=https://my.reiblackbook.com/contacts

# --- Browser automation behavior -------------------------------------------
# HEADLESS=false lets you WATCH the browser while it runs (recommended the
# first few live runs so you can confirm it is clicking the right things).
# Set to true once you trust it and want it to run in the background.
HEADLESS=false

# Slow every Playwright action down by this many milliseconds. Helpful while
# verifying selectors; set to 0 for full speed.
SLOWMO_MS=150

# Max milliseconds to wait for any single page element before giving up and
# marking the row Needs Review / Error (never a blind send).
ACTION_TIMEOUT_MS=15000

# --- Optional: property Sold/Listed verification (checked FIRST) -----------
# Before touching REI, each lead's property can be looked up to confirm it is
# not Sold or Listed. If it is, the row is marked Sold/Listed and NO text is
# sent. This can only ADD a block, never enable a send.
#
# PROPERTY_SOURCE options:
#   redfin         -> free public Redfin site, NO login needed (DEFAULT / always on)
#   propertyradar  -> PropertyRadar (requires the login below)
#   none           -> skip this step (rely on REI tags only)
# Leave blank or set to redfin to keep the Sold/Listed check always on.
PROPERTY_SOURCE=redfin

# Redfin (used when PROPERTY_SOURCE=redfin) — no login required.
# A home sold within this many months counts as "sold" (owner likely changed).
REDFIN_SOLD_WINDOW_MONTHS=24

# Make the dashboard Property Status / Address link straight to each address's
# exact Redfin page (fast lookup, no browser, works even when PROPERTY_SOURCE is
# not redfin). Set to false to turn the links off.
REDFIN_LINKS=true

# PropertyRadar (used when PROPERTY_SOURCE=propertyradar) — requires login.
PROPERTYRADAR_LOGIN_URL=https://www.propertyradar.com/login
PROPERTYRADAR_EMAIL=
PROPERTYRADAR_PASSWORD=
# A property whose owner changed within this many months counts as "sold".
PR_SOLD_WINDOW_MONTHS=18

# --- Batch limit -----------------------------------------------------------
# Max texts to actually SEND per run, to protect your number from carrier spam
# flags. 0 = unlimited. When the cap is hit the run stops with progress saved;
# click Start/Resume for the next batch (already-texted leads are skipped).
MAX_SENDS_PER_RUN=100

# --- Default company / message --------------------------------------------
# Which approved message to send when a lead has no Company Source column.
# The two messages differ only by this company name. Options:
#   Twin Home Buyer   |   Equity Track Inc.
DEFAULT_COMPANY=Twin Home Buyer

# Only text properties in these states (default California). Anything else is
# skipped as Out of State.
TEXT_STATES=CA,California

# If a lead's state can't be confirmed (blank on the sheet AND unreadable from
# REI), hold it for review instead of texting. Set to true to text unknown-state
# leads anyway. Default false (safer — never text an unconfirmed location).
ALLOW_UNKNOWN_STATE_TEXT=false

# Backend safety maximum: never send more than this many texts in one calendar
# day (across runs/restarts). Replaces the old per-run "Texts per Run" control.
DAILY_SEND_HARD_CAP=300

# A lead texted within this many days (rolling) is NOT eligible / NOT shown in
# the "Available to Text" tab, so nobody is re-texted too soon.
AVAILABLE_TEXT_MIN_DAYS=30

# Local memory. Default false = the app does NOT remember past results in a
# local file. Every lead is re-checked FRESH from REI/Redfin each run, and
# double-texting is prevented by reading the lead's LIVE REI chat (not a saved
# file). Set true to restore the persistent local memory + dashboard prefill.
USE_LEDGER_MEMORY=false

# After "Pull all from REI", automatically check every pulled lead against all
# texting rules (no texts sent) so the tabs fill in on their own. Set to false
# to just pull without auto-checking.
AUTO_CHECK_ON_PULL=true

# After a LIVE texting run finishes, automatically re-check the texts it sent
# (delivery status + seller replies) so the Percentage Report is accurate
# without a manual click. Set to false to require clicking Recheck yourself.
AUTO_RECHECK_AFTER_RUN=true

# --- Safety switch ---------------------------------------------------------
# Master live-send switch. Must be exactly "true" for any text to be sent.
# If false, every eligible lead is marked "Eligible - Send Blocked" and NO
# text goes out. Flip to true only after you have verified selectors on a
# test lead. There is no dry-run mode; this is the single kill switch.
# Ships as false so a first run is safe; turn on once selectors are verified.
ALLOW_LIVE_SEND=false
